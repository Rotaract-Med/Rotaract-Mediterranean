# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# IMPORTANT: The URL must include https:// and end with .supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Example (DO NOT USE THESE - they are just examples):
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFiY2RlZmdoaWprbG1ub3AiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYzMDQ0MDAwMCwiZXhwIjoxOTQ2MDE2MDAwfQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Steps to get your credentials:
# 1. Go to https://app.supabase.com/
# 2. Select your project (or create a new one)
# 3. Go to Settings > API
# 4. Copy the "Project URL" and "anon public" key
# 5. Paste them above (without quotes)
