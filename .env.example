# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# S3 / MinIO Configuration (Server-side only - DO NOT prefix with NEXT_PUBLIC)
S3_ENDPOINT=http://your-minio-endpoint:9000
S3_BUCKET_NAME=mdio
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_minio_access_key
S3_SECRET_ACCESS_KEY=your_minio_secret_key
S3_PUBLIC_URL=http://your-minio-endpoint:9000

# Note: S3 credentials are kept server-side for security.
# The presigned URL API route (/api/upload/presigned) generates
# temporary upload URLs so client never sees your S3 credentials.
